<mujoco model="02_SUB_RoboticArm">

  <compiler angle="radian" meshdir="meshes/" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="l1" file="l1.STL"/>
    <mesh name="l2" file="l2.STL"/>
    <mesh name="l3" file="l3.STL"/>
    <mesh name="l4" file="l4.STL"/>
  </asset>


  <worldbody>

    <!-- base -->
    <body name="base_link" pos="0 0 0">

      <geom type="mesh"
            mesh="base_link"
            rgba="0.3 0.3 0.3 1"
            contype="0"
            conaffinity="0"/>

      <!-- obstacles: four symmetric pillars around base_link in XY plane -->
      <geom name="obs_pillar_1" type="cylinder" size="0.02 0.15" pos="0.25 0.25 0.15" rgba="0.2 0.2 0.2 1"/>
      <geom name="obs_pillar_2" type="cylinder" size="0.02 0.15" pos="-0.25 0.25 0.15" rgba="0.2 0.2 0.2 1"/>
      <geom name="obs_pillar_3" type="cylinder" size="0.02 0.15" pos="-0.25 -0.25 0.15" rgba="0.2 0.2 0.2 1"/>
      <geom name="obs_pillar_4" type="cylinder" size="0.02 0.15" pos="0.25 -0.25 0.15" rgba="0.2 0.2 0.2 1"/>


      <!-- link1 -->
      <body name="l1" pos="0 -0.00169679 0.0135">

        <inertial pos="-0.0021817 0.009549 0.0424398"
                  quat="-0.224231 0.683618 -0.229243 0.655618"
                  mass="0.445365"
                  diaginertia="0.000495106 0.000494858 0.000349475"/>

        <joint name="j1"
               type="hinge"
               pos="0 0 0"
               axis="0 0 -1"
               range="-3.1416 3.1416"
               damping="0.01"/>

        <geom type="mesh"
              mesh="l1"
              rgba="1 1 1 1"/>


        <!-- link2 -->
        <body name="l2" pos="0 0.0573 0.071">

          <inertial pos="-0.0961211 -0.0492048 0.152551"
                    quat="0.686176 -0.191017 -0.190799 0.675479"
                    mass="0.66067"
                    diaginertia="0.00510695 0.00499524 0.000208333"/>

          <joint name="j2"
                 type="hinge"
                 pos="0 0 0"
                 axis="0 1 0"
                 range="-3.1416 3.1416"
                 damping="0.01"/>

          <geom type="mesh"
                mesh="l2"
                rgba="0.79 0.82 0.93 1"/>


          <!-- link3 -->
          <body name="l3" pos="-0.229899 -0.0025 0.375162">

            <inertial pos="0.179461 -0.0547823 -0.119425"
                      quat="-4.04863e-05 0.881243 -0.00158765 0.472661"
                      mass="0.366439"
                      diaginertia="0.000848879 0.000835934 9.95032e-05"/>

            <joint name="j3"
                   type="hinge"
                   pos="0 0 0"
                   axis="0 -1 0"
                   range="-3.1416 3.1416"
                   damping="0.01"/>

            <geom type="mesh"
                  mesh="l3"
                  rgba="0.9 0.92 0.93 1"/>


            <!-- link4 / end-effector -->
            <body name="l4"
                  pos="0.329385 -0.0273 -0.218015"
                  quat="0.707107 0.707107 0 0">

              <inertial pos="0.0124065 -0.0173866 0.0296216"
                        quat="0.0435172 0.705766 -0.0435234 0.705766"
                        mass="0.0723669"
                        diaginertia="1.33062e-05 1.26717e-05 4.81229e-06"/>

              <joint name="j4"
                     type="hinge"
                     pos="0 0 0"
                     axis="0 0 -1"
                     range="-3.1416 3.1416"
                     damping="0.01"/>

              <geom type="mesh"
                    mesh="l4"
                    rgba="1 1 1 1"/>
              <geom name="attachment_geom"
                    type="sphere"
                    pos="0.01 -0.05 0.025"
                    size="0.01"
                    rgba="0 1 0 0"
                    contype="0"
                    conaffinity="1"
                    group="3"/>
              <site name="attachment_site" pos="0.01 -0.05 0.025" type="sphere" size="0.01" rgba="0 1 0 1"/>
              <site name="eef_site" pos="0.01 0 0.025" type="sphere" size="0.015" rgba="1 0.6 0 1"/>
              <!-- end effector sites -->
              <!-- tool0 placed on joint axis so rotation doesn't move XYZ -->
              
            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>


  <!-- actuators -->
  <actuator>

    <!-- Disable position actuators to avoid fighting torque control (qfrc_applied). -->
    <position name="j1_pos" joint="j1" kp="0"/>
    <position name="j2_pos" joint="j2" kp="0"/>
    <position name="j3_pos" joint="j3" kp="0"/>
    <position name="j4_pos" joint="j4" kp="0"/>

  </actuator>

</mujoco>
