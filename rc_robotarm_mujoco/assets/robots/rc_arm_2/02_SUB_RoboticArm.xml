<mujoco model="02_SUB_RoboticArm">

  <compiler angle="radian" meshdir="meshes/" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <asset>
    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="l1" file="l1.STL"/>
    <mesh name="l2" file="l2.STL"/>
    <mesh name="l3" file="l3.STL"/>
    <mesh name="l4" file="l4.STL"/>
  </asset>


  <worldbody>

    <!-- base -->
    <body name="base_link" pos="0 0.00169679 0">

      <geom type="mesh"
            mesh="base_link"
            rgba="0.3 0.3 0.3 1"
            contype="0"
            conaffinity="0"/>

      <!-- link1 -->
      <body name="l1" pos="0 -0.00169679 0.0135" euler="0 0 0">

        <inertial pos="-0.0021817 0.009549 0.0424398"
                  mass="0.445365070024422"
                  fullinertia="0.000349710703636588 0.000494944126340276 0.000494784132001916 -8.74801250935224e-07 5.7841876423728e-06 -8.50815789238056e-08"/>

         <joint name="j1"
           type="hinge"
           pos="0 0 0"
           axis="0 0 -1"
           range="-1.865 2.365"
           damping="0.01"/>

        <geom type="mesh"
              mesh="l1"
              rgba="1 1 1 1"
              contype="1"
              conaffinity="1"/>


        <!-- link2 -->
        <body name="l2" pos="0 0.0573 0.071">

          <inertial pos="-0.0961211 -0.0492048 0.152551"
                    mass="0.66066950131522"
                    fullinertia="0.00370138700167397 0.00510682905939535 0.00150230118954672 1.25377482841611e-05 0.00212590021931993 -1.74886949186245e-05"/>

             <joint name="j2"
               type="hinge"
               pos="0 0 0"
               axis="0 1 0"
               range="0.0 1.85"
               damping="0.01"/>

          <geom type="mesh"
                mesh="l2"
                rgba="0.79 0.82 0.93 1"
                contype="1"
                conaffinity="1"/>


          <!-- link3 -->
          <body name="l3" pos="-0.229899 -0.0025 0.375162">

            <inertial pos="0.179461 -0.0547823 -0.119425"
                      mass="0.366439493147188"
                      fullinertia="0.000328823125447746 0.000835932856081032 0.000619560605110811 8.56658575293569e-07 0.000345338078938459 -6.12931618014208e-07"/>

                 <joint name="j3"
                   type="hinge"
                   pos="0 0 0"
                   axis="0 -1 0"
                   range="0.0 2.13861"
                   damping="0.01"/>

            <geom type="mesh"
                  mesh="l3"
                  rgba="0.9 0.92 0.93 1"
                  contype="1"
                  conaffinity="1"/>


            <!-- link4 / end-effector -->
            <body name="l4"
                  pos="0.329385 -0.0273 -0.218015"
                  quat="0.707107 0.707107 0 0">

              <inertial pos="0.0124065 -0.0173866 0.0296216"
                        mass="0.0723669216572841"
                        fullinertia="4.93092728814008e-06 1.25530593705886e-05 1.33062083909566e-05 9.58295916234749e-07 -5.07024039279827e-12 -4.97267313424938e-12"/>

              <joint name="j4"
                type="hinge"
                pos="0 0 0"
                axis="0 0 -1"
                range="-0.5313 1.2963"
                damping="0.01"/>

              <geom type="mesh"
                    mesh="l4"
                  rgba="1 1 1 1"
                  contype="1"
                  conaffinity="1"/>
              <geom name="attachment_geom"
                    type="sphere"
                    pos="0.01 -0.05 0.025"
                    size="0.01"
                    rgba="0 1 0 0"
                    contype="1"
                    conaffinity="1"
                    group="3"/>
              <site name="attachment_site" pos="0.01 -0.05 0.025" type="sphere" size="0.01" rgba="0 1 0 1"/>
              <site name="eef_site" pos="0.01 -0.05 0.025" type="sphere" size="0.015" rgba="1 0.6 0 1"/>
              <!-- end effector sites -->
              <!-- tool0 placed on joint axis so rotation doesn't move XYZ -->
              
            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>


  <!-- actuators -->
  <actuator>

    <!-- Disable position actuators to avoid fighting torque control (qfrc_applied). -->
    <position name="j1_pos" joint="j1" kp="0"/>
    <position name="j2_pos" joint="j2" kp="0"/>
    <position name="j3_pos" joint="j3" kp="0"/>
    <position name="j4_pos" joint="j4" kp="0"/>

  </actuator>

</mujoco>
